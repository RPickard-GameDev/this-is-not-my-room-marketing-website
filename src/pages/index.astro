---
import Layout from '@layouts/Layout.astro';
import Hero from '@components/sections/Hero.astro';
import bedroomConceptImage from '../assets/images/home/Bedroom_Concept.png'

const seoTitle = "This Is Not My Room";
const seoDescription = "A Horror Puzzle game, coming soon!";

const heroContent = {
    title: 'Coming Soon!',
    description: '',
    backgroundImage: bedroomConceptImage,
    overlayOpacity: 0.2
}

---

<Layout title={seoTitle} description={seoDescription}>
    <Hero content={heroContent} />
</Layout>